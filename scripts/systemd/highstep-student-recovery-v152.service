[Unit]
Description=RobotLab highstep Student recovery v1.5.2 supervisor
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/lxq/Softwares/robot_lab
Environment=PYTHONUNBUFFERED=1
Environment=ALL_PROXY=socks5h://127.0.0.1:10808
Environment=HTTP_PROXY=http://127.0.0.1:10809
Environment=HTTPS_PROXY=http://127.0.0.1:10809
Environment=NO_PROXY=127.0.0.1,localhost
Environment=HIGHSTEP_V15_PREREGISTRATION_PATH=/home/lxq/Softwares/robot_lab/tmp/highstep_student_recovery_v152_20260713/preregistration_v1.json
Environment=HIGHSTEP_V15_PREREGISTRATION_SHA256=473b8554d25d253886547fe4af72d49e30dad796d66fd9a3944e1d0ad8238ec2
Environment=CODEX_MODEL=gpt-5.6-sol
Environment=CODEX_REASONING_EFFORT=max
ExecStart=/home/lxq/miniconda3/envs/env_isaaclab/bin/python -u /home/lxq/Softwares/robot_lab/tools/highstep_student_recovery_v152_supervisor.py
Restart=on-failure
RestartSec=30
KillMode=control-group
TimeoutStopSec=75
StandardOutput=append:/home/lxq/Softwares/robot_lab/tmp/highstep_student_recovery_v152_20260713/supervisor.log
StandardError=append:/home/lxq/Softwares/robot_lab/tmp/highstep_student_recovery_v152_20260713/supervisor.log

[Install]
WantedBy=default.target
